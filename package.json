{
  "name": "@celados/ripple-ark",
  "version": "0.1.0",
  "description": "Ripple-native bindings for Zag component state machines",
  "keywords": [
    "ripple",
    "tsrx",
    "zag-js",
    "headless-ui",
    "ark-ui"
  ],
  "author": "Ethan Huo <huodong.work@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/celados/ripple-ark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celados/ripple-ark.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "bun run build && tsc --noEmit",
    "test": "bun run build && vitest run"
  },
  "publishConfig": {
    "registry": "https://npm.celados.com",
    "access": "public"
  },
  "dependencies": {
    "@celados/ripple-zag": "0.4.1",
    "@zag-js/accordion": "^1.43.0",
    "@zag-js/angle-slider": "^1.43.0",

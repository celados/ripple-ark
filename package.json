		"./json-tree-view": "./src/utilities/json-tree-view.tsrx",
		"./locale": "./src/providers/locale.tsrx",
		"./swap": "./src/utilities/swap.tsrx",
		"./toast": "./src/utilities/toast.tsrx",
		"./*": "./src/generated/*.tsrx",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsrx-tsc --noEmit",
		"typecheck": "tsrx-tsc --noEmit",
		"test": "vitest run tests/exports.test.ts tests/smoke.test.ts",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"source:check": "node scripts/check-package.mjs",
		"verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run source:check",
		"generate:bindings": "bun scripts/generate-bindings.ts"
	},
	"publishConfig": {
		"registry": "https://npm.celados.com",
		"access": "public"

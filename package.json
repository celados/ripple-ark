	"repository": {
		"type": "git",
		"url": "git+https://github.com/celados/ripple-ark.git"
	},
	"type": "module",
	"files": [
		"src",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": "./src/index.ts",
		"./client-only": "./src/utilities/client-only.tsrx",
		"./collection": "./src/utilities/collection.ts",
		"./download-trigger": "./src/utilities/download-trigger.tsrx",
		"./field": "./src/utilities/field.tsrx",
